# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB)
# If MongoDB is not running, the server automatically uses an in-memory resilient fallback
MONGO_URI=mongodb://127.0.0.1:27017/apexfit_production_db

# Security & API Keys (Exp 8 Bearer Token)
API_SECRET_KEY=Bearer apexfit-secret-key-2026

# Allowed Frontend Origins (Comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
