# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production build output
dist/
build/

# Environment files (NEVER commit these)
.env
.env.local
.env.production

# Vite cache
.vite/

# OS files
.DS_Store
Thumbs.db

# Create/replace .gitignore in the repo root
Set-Content -Path ".gitignore" -Value @"
node_modules/
dist/
.env
.env.local
.env.production
npm-debug.log*
.DS_Store
Thumbs.db
"@
